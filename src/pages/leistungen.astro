---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Cta from '../components/Cta.astro';
---
<Base title="Leistungen" description="Konzeption, Webdesign, CMS-Entwicklung, Funktionsmodule, Barrierefreiheit, Content-Migration, Hosting, Wartung, Contentpflege und Schulung für öffentliche Auftraggeber.">
  <section class="page-head">
    <div class="container">
      <span class="eyebrow">Leistungen</span>
      <h1>Alle Leistungen für Ihren Internetauftritt</h1>
      <p class="lead">Wir decken den gesamten Lebenszyklus einer Website ab, von der Anforderungsanalyse über Gestaltung und Entwicklung bis zu Betrieb und Pflege über mehrere Jahre. So, wie es öffentliche Leistungsbeschreibungen üblicherweise verlangen.</p>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid-2">
      <div class="card"><div class="icon"><Icon name="search" /></div><h3>Konzeption und Beratung</h3>
        <ul class="checklist"><li>Anforderungsanalyse mit Fachbereich, IT und Datenschutz</li><li>Zielgruppen, Informationsarchitektur und Navigationskonzept</li><li>Funktions- und Rollenkonzept für die Redaktion</li><li>Wireframes und klickbare Prototypen</li><li>Projekt- und Zeitplan mit Meilensteinen</li></ul></div>
      <div class="card"><div class="icon"><Icon name="doc" /></div><h3>Webdesign</h3>
        <ul class="checklist"><li>Responsives Design für Smartphone, Tablet und Desktop</li><li>Umsetzung bestehender Corporate-Design-Richtlinien</li><li>Entwicklung eines Erscheinungsbilds für neue Projekte</li><li>Einbindung von Förderlogos und Pflichthinweisen</li><li>Barrierearme Farb- und Schriftgestaltung</li></ul></div>
      <div class="card"><div class="icon"><Icon name="cms" /></div><h3>CMS-Entwicklung</h3>
        <ul class="checklist"><li>TYPO3, WordPress, Drupal, Contao, Joomla, Neos, Craft CMS</li><li>Headless-CMS wie Strapi oder Directus</li><li>Individuelle Inhaltselemente und Templates</li><li>Rollen, Rechte und Freigabeprozesse (Vier-Augen-Prinzip)</li><li>Schnittstellen zu Fachverfahren und Datenquellen</li></ul></div>
      <div class="card"><div class="icon"><Icon name="access" /></div><h3>Barrierefreiheit</h3>
        <ul class="checklist"><li>Umsetzung nach WCAG 2.1 AA und BITV 2.0</li><li>Prüfung mit Werkzeugen, Screenreader und Tastatur</li><li>Erklärung zur Barrierefreiheit und Feedback-Mechanismus</li><li>Leichte Sprache und Videos in Deutscher Gebärdensprache</li><li>Barrierefreiheits-Audit bestehender Websites</li></ul></div>
      <div class="card"><div class="icon"><Icon name="server" /></div><h3>Hosting und Betrieb</h3>
        <ul class="checklist"><li>Hosting in zertifizierten Rechenzentren in Deutschland</li><li>Domain, SSL-Zertifikate und E-Mail-Weiterleitungen</li><li>Sicherheits- und Funktionsupdates von CMS und Erweiterungen</li><li>Tägliche Backups und Wiederherstellungstests</li><li>Monitoring, Support und vereinbarte Reaktionszeiten (SLA)</li></ul></div>
      <div class="card"><div class="icon"><Icon name="wrench" /></div><h3>Contentpflege und Redaktion</h3>
        <ul class="checklist"><li>Einpflegen von Texten, Bildern, Terminen und Dokumenten</li><li>Stundenkontingent als Pauschale über die Vertragslaufzeit</li><li>Redaktionsschulungen vor Ort oder online</li><li>Redaktionshandbuch und Kurzanleitungen</li><li>Unterstützung bei Texten, Fotos und Social Media</li></ul></div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Funktionen und Module</span>
        <h2>Was Ihre Website können soll</h2>
        <p class="lead">Diese Funktionen werden in Ausschreibungen für Projekt- und Behördenwebsites häufig gefordert. Wir setzen sie mit bewährten Erweiterungen oder individuell um.</p>
      </div>
      <div class="grid grid-3">
        <div class="card"><h3>Inhalte und Information</h3><ul class="checklist"><li>News und Pressemitteilungen</li><li>Veranstaltungskalender mit Filter</li><li>Download-Bereich und Dokumentenarchiv</li><li>Volltextsuche</li><li>FAQ und Glossar</li></ul></div>
        <div class="card"><h3>Verzeichnisse und Karten</h3><ul class="checklist"><li>Akteurs-, Gewerbe- und Vereinsverzeichnis</li><li>Ansprechpartner und Zuständigkeiten</li><li>Interaktive Karten mit OpenStreetMap</li><li>Standort- und Flächenübersichten</li><li>Projektdatenbanken</li></ul></div>
        <div class="card"><h3>Kommunikation und Beteiligung</h3><ul class="checklist"><li>Kontakt- und Anmeldeformulare</li><li>Umfragen und Beteiligungsformate</li><li>Newsletter mit Double-Opt-in</li><li>Datenschutzkonforme Einbindung von Social Media und Videos</li><li>Bildergalerien und Mediatheken</li></ul></div>
        <div class="card"><h3>Mehrsprachigkeit und Zugänglichkeit</h3><ul class="checklist"><li>Mehrere Sprachversionen</li><li>Bereiche in Leichter Sprache</li><li>Gebärdensprache-Videos</li><li>Druck- und PDF-freundliche Ansichten</li></ul></div>
        <div class="card"><h3>Redaktion und Verwaltung</h3><ul class="checklist"><li>Rollen und Freigabe-Workflows</li><li>Zeitgesteuerte Veröffentlichung</li><li>Versionierung von Inhalten</li><li>Medienverwaltung mit Bildrechten und Alternativtexten</li></ul></div>
        <div class="card"><h3>Auswertung und Auffindbarkeit</h3><ul class="checklist"><li>Suchmaschinenoptimierung (SEO)</li><li>Cookiefreie Besucherstatistik, z. B. Matomo</li><li>Strukturierte Daten und Sitemaps</li><li>Weiterleitungen beim Relaunch</li></ul></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid-2">
      <div>
        <span class="eyebrow">Relaunch</span>
        <h2>Content-Migration aus Altsystemen</h2>
        <p>Sie haben bereits eine Website und viele Inhalte? Wir übernehmen Texte, Bilder, Dokumente und Termine aus Ihrem bisherigen System, bereinigen sie und überführen sie strukturiert in das neue CMS. Alte Adressen leiten wir weiter, damit Links und Suchmaschinenplatzierungen erhalten bleiben.</p>
      </div>
      <div>
        <span class="eyebrow">Übernahme</span>
        <h2>Betreuung bestehender Websites</h2>
        <p>Ihr bisheriger Dienstleister steht nicht mehr zur Verfügung? Wir analysieren den Zustand Ihrer Website, schließen Sicherheitslücken, bringen das System auf einen aktuellen Stand und übernehmen Betrieb und Pflege.</p>
      </div>
    </div>
  </section>

  <Cta />
</Base>
