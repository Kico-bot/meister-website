---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
---
<Base title="Öffentliche Auftraggeber" description="Websites für Behörden, Kommunen, Bezirksämter und Wirtschaftsförderungen: barrierefrei nach BITV 2.0, DSGVO-konform, mit CMS, Betrieb und Contentpflege als Pauschale.">
  <section class="page-head">
    <div class="container">
      <span class="eyebrow">Für Vergabestellen und Fachbereiche</span>
      <h1>Websites für die öffentliche Hand</h1>
      <p class="lead">Ob Projektwebsite für ein Standortmanagement, Informationsportal oder Auftritt einer Einrichtung: Wir liefern, was Ihre Leistungsbeschreibung fordert, und dokumentieren es so, dass Sie es prüfen und bewerten können.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Typische Anforderungen und wie wir sie erfüllen</h2>
      </div>
      <div class="table-wrap">
        <table>
          <caption class="visually-hidden">Anforderungen öffentlicher Auftraggeber und Umsetzung</caption>
          <thead><tr><th scope="col">Anforderung</th><th scope="col">Umsetzung</th></tr></thead>
          <tbody>
            <tr><td>Barrierefreiheit (BITV 2.0, WCAG 2.1 AA, BGG)</td><td>Fester Bestandteil von Konzept, Design und Entwicklung. Prüfprotokoll, Erklärung zur Barrierefreiheit und Feedback-Mechanismus inklusive.</td></tr>
            <tr><td>Datenschutz (DSGVO, TDDDG)</td><td>Hosting in Deutschland, AVV nach Art. 28 DSGVO, keine Einbindung von Drittanbietern ohne Einwilligung, Datenschutzerklärung als Entwurf.</td></tr>
            <tr><td>Informationssicherheit</td><td>Härtung nach BSI-Empfehlungen, Rollen- und Rechtekonzept, Backup- und Wiederherstellungskonzept. Auf Wunsch ein kurzes Sicherheitskonzept in IT-Grundschutz-Logik.</td></tr>
            <tr><td>Redaktionssystem (CMS)</td><td>Umsetzung mit dem vorgegebenen oder einem passenden Open-Source-CMS (z. B. TYPO3, WordPress, Drupal, Contao), Rollen und Freigaben, Schulung und Redaktionshandbuch.</td></tr>
            <tr><td>Funktionsumfang</td><td>Module wie Veranstaltungskalender, News, Akteursverzeichnis, Karten, Downloads, Formulare und Newsletter.</td></tr>
            <tr><td>Übernahme bestehender Inhalte</td><td>Migration aus dem Altsystem inklusive Weiterleitungen.</td></tr>
            <tr><td>Betrieb über mehrere Jahre</td><td>Hosting, Wartung, Updates, Backups und Support mit festen Reaktionszeiten als Pauschale über die gesamte Vertragslaufzeit.</td></tr>
            <tr><td>Contentpflege</td><td>Stundenkontingent als Pauschale, zum Beispiel 72 Stunden über die Laufzeit, mit nachvollziehbarer Abrechnung.</td></tr>
            <tr><td>Corporate Design</td><td>Umsetzung Ihrer Gestaltungsrichtlinien, Logos und Förderhinweise (z. B. EU-, Bundes- oder Landesförderung).</td></tr>
            <tr><td>Übergabe und Exit</td><td>Quellcode, Zugänge, Betriebsdokumentation und Unterstützung beim Wechsel. Kein Lock-in.</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container grid grid-2">
      <div>
        <span class="eyebrow">Projektmanagement</span>
        <h2>Verlässlich vom Zuschlag bis zum Vertragsende</h2>
        <ul class="checklist">
          <li>Auftaktgespräch und abgestimmter Projektplan mit Meilensteinen</li>
          <li>Feste Projektleitung und Vertretungsregelung</li>
          <li>Regelmäßige Abstimmungstermine und kurze Statusberichte</li>
          <li>Testumgebung, auf der Sie jederzeit den Stand sehen</li>
          <li>Formale Abnahme mit Prüfprotokoll</li>
        </ul>
      </div>
      <div>
        <span class="eyebrow">Angebot und Unterlagen</span>
        <h2>Vollständige Angebote, pünktlich eingereicht</h2>
        <ul class="checklist">
          <li>Konzept, Zeitplan und Preisblatt passend zu Ihrer Leistungsbeschreibung</li>
          <li>Eigenerklärungen, Referenzen und Versicherungsnachweise</li>
          <li>Bieterfragen frühzeitig und präzise</li>
          <li>Angebotsabgabe über die gängigen Vergabeplattformen</li>
          <li>Verfahren nach UVgO und VgV, Verhandlungsvergaben und Direktaufträge</li>
          <li>Vertragsgestaltung auf Basis EVB-IT oder Ihrer Vertragsbedingungen</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <span class="eyebrow">Erfahrung im öffentlichen Sektor</span>
      <h2>Wir kennen die Arbeitsweise von Behörden</h2>
      <p>Unser Team hat mehrere Jahre in Digitalisierungs- und Sicherheitsprojekten für öffentliche Auftraggeber gearbeitet, unter anderem für Sicherheits- und Gesundheitsbehörden. Abstimmungen mit Fachbereichen, Datenschutzbeauftragten, Personalvertretung und IT-Leitung gehören für uns zum Alltag, ebenso Sicherheitskonzepte nach BSI IT-Grundschutz.</p>
      <p class="note">Sie planen eine Ausschreibung oder Markterkundung? Gern geben wir Ihnen eine unverbindliche Kostenschätzung für Ihre Haushaltsplanung.</p>
    </div>
  </section>

  <Cta title="Sie planen einen neuen Internetauftritt?" text="Schicken Sie uns Ihre Leistungsbeschreibung oder den Link zur Bekanntmachung. Wir melden uns kurzfristig mit einer Einschätzung." />
</Base>
