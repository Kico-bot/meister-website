---
import Base from '../layouts/Base.astro';
import { site } from '../site';
---
<Base title="Impressum" description="Impressum von Webseiten-Meister.">
  <section class="page-head"><div class="container"><h1>Impressum</h1></div></section>
  <section class="section"><div class="container prose">
    <h2>Angaben gemäß § 5 DDG</h2>
    <p>{site.owner}<br />{site.name}<br />{site.street}<br />{site.city}</p>
    <h2>Kontakt</h2>
    <p>E-Mail: <a href={`mailto:${site.email}`}>{site.email}</a>{site.phone && <><br />Telefon: {site.phone}</>}</p>
    {site.vatId && <><h2>Umsatzsteuer-ID</h2><p>Umsatzsteuer-Identifikationsnummer gemäß § 27a UStG: {site.vatId}</p></>}
    <h2>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
    <p>{site.owner}, Anschrift wie oben</p>
    <h2>Verbraucherstreitbeilegung</h2>
    <p>Ich bin nicht bereit und nicht verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.</p>
  </div></section>
</Base>
