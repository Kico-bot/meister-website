---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Cta from '../components/Cta.astro';
import { site } from '../site';
---
<Base title={site.name} description="Webagentur für öffentliche Auftraggeber: Konzeption, Webdesign, CMS-Entwicklung mit TYPO3, WordPress, Drupal und mehr, Barrierefreiheit nach BITV 2.0, Hosting, Betrieb und Contentpflege.">
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Webagentur für öffentliche Auftraggeber</span>
        <h1>Digitale Auftritte für Verwaltung, Kommunen und Förderprojekte.</h1>
        <p class="lead">Wir konzipieren, gestalten und entwickeln Websites und Portale für die öffentliche Hand und betreuen sie über die gesamte Vertragslaufzeit. Auf dem CMS Ihrer Wahl, barrierefrei nach BITV 2.0 und abgestimmt auf die Anforderungen Ihrer Leistungsbeschreibung.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/kontakt/">Projekt anfragen</a>
          <a class="btn btn-light" href="/oeffentliche-auftraggeber/">Für Vergabestellen</a>
        </div>
      </div>
      <aside class="hero-card" aria-labelledby="hero-card-title">
        <h2 id="hero-card-title">Alles aus einer Hand</h2>
        <ul class="checklist">
          <li>Konzeption, UX und Webdesign im Corporate Design</li>
          <li>Entwicklung mit TYPO3, WordPress, Drupal, Contao und weiteren CMS</li>
          <li>Barrierefreiheit nach WCAG 2.1 AA / BITV 2.0</li>
          <li>Hosting in Deutschland bzw. der EU, Wartung und Support</li>
          <li>Contentpflege und Redaktionsschulungen</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Leistungen</span>
        <h2>Vom Konzept bis zum laufenden Betrieb</h2>
        <p class="lead">Wir begleiten Ihr Projekt in allen Phasen, die in öffentlichen Ausschreibungen üblicherweise gefordert sind.</p>
      </div>
      <div class="grid grid-3">
        <div class="card"><div class="icon"><Icon name="search" /></div><h3>Konzeption und UX</h3><p>Zielgruppenanalyse, Informationsarchitektur, Navigations- und Inhaltskonzept, Wireframes und Klick-Prototypen.</p></div>
        <div class="card"><div class="icon"><Icon name="doc" /></div><h3>Webdesign</h3><p>Responsives Design auf Basis Ihres Corporate Designs, inklusive Förderlogos und Pflichthinweisen von EU, Bund und Ländern.</p></div>
        <div class="card"><div class="icon"><Icon name="cms" /></div><h3>CMS-Entwicklung</h3><p>Umsetzung auf dem System, das zu Ihren Vorgaben passt: TYPO3, WordPress, Drupal, Contao, Joomla, Neos oder headless.</p></div>
        <div class="card"><div class="icon"><Icon name="access" /></div><h3>Barrierefreiheit</h3><p>Umsetzung und Prüfung nach BITV 2.0, Erklärung zur Barrierefreiheit, Leichte Sprache und Gebärdensprache-Inhalte.</p></div>
        <div class="card"><div class="icon"><Icon name="server" /></div><h3>Hosting und Betrieb</h3><p>Hosting in deutschen Rechenzentren, Updates, Backups, Monitoring und Support mit vereinbarten Reaktionszeiten.</p></div>
        <div class="card"><div class="icon"><Icon name="wrench" /></div><h3>Contentpflege und Schulung</h3><p>Redaktionelle Pflege als Stundenkontingent, Schulungen und Handbücher für Ihre Redakteurinnen und Redakteure.</p></div>
      </div>
      <div class="btn-row"><a class="btn btn-outline" href="/leistungen/">Alle Leistungen ansehen</a></div>
    </div>
  </section>

  <section class="section section-navy">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">CMS &amp; Technik</span>
        <h2>Wir arbeiten mit dem System, das zu Ihnen passt</h2>
        <p>Viele Verwaltungen haben feste Vorgaben für das Redaktionssystem oder wollen bestehende Inhalte weiter nutzen. Wir setzen Projekte auf allen gängigen Open-Source-CMS um, migrieren Inhalte aus Altsystemen und beraten neutral, wenn die Wahl noch offen ist.</p>
      </div>
      <ul class="tags" aria-label="Content-Management-Systeme">
        <li>TYPO3</li><li>WordPress</li><li>Drupal</li><li>Contao</li><li>Joomla</li><li>Neos</li><li>Craft CMS</li><li>Strapi</li><li>Directus</li><li>Statische Websites (Astro, Hugo)</li>
      </ul>
      <div class="btn-row"><a class="btn btn-primary" href="/cms/">Mehr zu CMS &amp; Technik</a></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Typische Projekte</span>
        <h2>Wofür öffentliche Auftraggeber uns beauftragen</h2>
      </div>
      <div class="grid grid-3">
        <div class="card"><h3>Projektwebsites</h3><p>Für Standort-, Quartiers- und Citymanagement, Stadtentwicklungs- und Förderprojekte, mit Terminen, Neuigkeiten und Akteursverzeichnis.</p></div>
        <div class="card"><h3>Behörden- und Einrichtungsportale</h3><p>Internetauftritte von Ämtern, Eigenbetrieben, Bibliotheken, Museen, Schulen und Hochschulen.</p></div>
        <div class="card"><h3>Wirtschaftsförderung und Standortmarketing</h3><p>Portale mit Gewerbeflächen, Unternehmensverzeichnis, Ansprechpartnern und Veranstaltungen.</p></div>
        <div class="card"><h3>Bürgerbeteiligung</h3><p>Informationsseiten zu Planungsvorhaben mit Umfragen, Beteiligungsformularen und Dokumentation.</p></div>
        <div class="card"><h3>Kampagnen- und Themenseiten</h3><p>Zeitlich begrenzte Websites zu Aktionen, Jubiläen oder Informationskampagnen.</p></div>
        <div class="card"><h3>Relaunch und Migration</h3><p>Modernisierung bestehender Auftritte, Umzug auf ein aktuelles CMS und Übernahme vorhandener Inhalte.</p></div>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Warum Webseiten-Meister</span>
        <h2>Wir kennen die Anforderungen der öffentlichen Hand</h2>
      </div>
      <div class="grid grid-3">
        <div class="card"><div class="icon"><Icon name="access" /></div><h3>Barrierefrei als Standard</h3><p>BITV 2.0 und WCAG 2.1 AA sind bei uns kein Aufpreis, sondern Grundlage jedes Projekts. Mit Prüfprotokoll zur Abnahme.</p></div>
        <div class="card"><div class="icon"><Icon name="lock" /></div><h3>Datenschutz und Sicherheit</h3><p>Hosting in Deutschland, AV-Vertrag, keine Drittanbieter ohne Einwilligung und Härtung nach BSI-Empfehlungen.</p></div>
        <div class="card"><div class="icon"><Icon name="doc" /></div><h3>Erfahrung mit Vergaben</h3><p>Vollständige Angebotsunterlagen, nachvollziehbare Konzepte und klare Pauschalen für Erstellung, Betrieb und Pflege.</p></div>
        <div class="card"><div class="icon"><Icon name="users" /></div><h3>Feste Ansprechperson</h3><p>Ein Projektleiter vom Auftakt bis zum Vertragsende, mit geregelter Vertretung und kurzen Wegen.</p></div>
        <div class="card"><div class="icon"><Icon name="euro" /></div><h3>Planbare Kosten</h3><p>Festpreis für die Erstellung, Pauschalen für Betrieb und Contentpflege über mehrere Jahre. Ideal für Haushaltsplanung und Fördermittel.</p></div>
        <div class="card"><div class="icon"><Icon name="shield" /></div><h3>Kein Lock-in</h3><p>Open-Source-Systeme, vollständige Übergabe von Quellcode, Zugängen und Dokumentation.</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Projektablauf</span>
        <h2>So läuft ein Projekt mit uns ab</h2>
      </div>
      <ol class="steps">
        <li><h3>Auftakt und Konzept</h3><p>Kick-off, Anforderungsaufnahme, Seitenstruktur, Funktionsumfang und Zeitplan mit Meilensteinen.</p></li>
        <li><h3>Design und Entwicklung</h3><p>Designentwürfe, Umsetzung im CMS, Einrichtung der Module und Übernahme der Inhalte auf einer Testumgebung.</p></li>
        <li><h3>Test, Schulung, Abnahme</h3><p>Prüfung auf Barrierefreiheit, Datenschutz, Sicherheit und Browser. Redaktionsschulung, Handbuch und formale Abnahme.</p></li>
        <li><h3>Betrieb und Pflege</h3><p>Livegang, Hosting, Wartung, Support und Contentpflege bis zum Ende der Vertragslaufzeit.</p></li>
      </ol>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Häufige Fragen</span>
        <h2>Gut zu wissen</h2>
      </div>
      <div class="prose">
        <details><summary>Mit welchem CMS arbeiten Sie?</summary><p>Mit dem, das zu Ihren Anforderungen passt. Wir setzen Projekte unter anderem mit TYPO3, WordPress, Drupal, Contao, Joomla und Neos um. Gibt Ihre Verwaltung ein System vor, arbeiten wir damit. Ist die Wahl offen, empfehlen wir eines nach Umfang, Redaktionsprozess und Betriebsaufwand.</p></details>
        <details><summary>Können Sie unsere bestehende Website übernehmen?</summary><p>Ja. Wir übernehmen Betrieb und Pflege bestehender Websites oder migrieren Inhalte aus Ihrem Altsystem in ein neues CMS, einschließlich Weiterleitungen, damit Links und Suchmaschinenplatzierungen erhalten bleiben.</p></details>
        <details><summary>Nehmen Sie an öffentlichen Ausschreibungen teil?</summary><p>Ja, unter anderem bei Verfahren nach UVgO und VgV, bei Verhandlungsvergaben und Direktaufträgen. Wir reichen Angebote über die gängigen Vergabeplattformen ein.</p></details>
        <details><summary>Was kostet eine Website?</summary><p>Das hängt vom Umfang ab: Eine kleine Projektwebsite ist deutlich günstiger als ein Portal mit vielen Modulen und mehrjährigem Betrieb. Nach einem Gespräch erhalten Sie ein Angebot mit Festpreis oder eine Kostenschätzung für Ihre Haushaltsplanung.</p></details>
        <details><summary>Wie lange dauert ein Projekt?</summary><p>Eine kleine Projektwebsite ist in vier bis sechs Wochen umgesetzt, ein größeres Portal in drei bis sechs Monaten. Den genauen Zeitplan stimmen wir im Konzept mit Ihnen ab.</p></details>
      </div>
    </div>
  </section>

  <Cta />
</Base>
