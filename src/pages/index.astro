---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Cta from '../components/Cta.astro';
import { site } from '../site';
---
<Base title={site.name} description="Webagentur aus München: Websites, Onlineshops, Landingpages und Web-Anwendungen für Unternehmen, Selbständige, Vereine und öffentliche Auftraggeber. Mit WordPress, TYPO3, Shopware und mehr.">
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Ihre Webagentur aus München</span>
        <h1>Websites, die Eindruck machen und Ergebnisse bringen.</h1>
        <p class="lead">Ob Firmenwebsite, Onlineshop, Vereinsseite oder großes Portal: Wir setzen Ihr Webprojekt um, egal wie groß es ist. Von der ersten Idee über Design und Entwicklung bis zur Betreuung im Alltag.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/kontakt/">Projekt anfragen</a>
          <a class="btn btn-light" href="/leistungen/">Unsere Leistungen</a>
        </div>
      </div>
      <aside class="hero-card" aria-labelledby="hero-card-title">
        <h2 id="hero-card-title">Alles aus einer Hand</h2>
        <ul class="checklist">
          <li>Konzept, Webdesign und Entwicklung</li>
          <li>Websites, Onlineshops, Landingpages und Web-Apps</li>
          <li>WordPress, TYPO3, Shopware und viele weitere Systeme</li>
          <li>Suchmaschinenoptimierung, Barrierefreiheit und Datenschutz</li>
          <li>Hosting, Wartung und Pflege Ihrer Inhalte</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Für wen wir arbeiten</span>
        <h2>Für jede Branche und jede Größe</h2>
        <p class="lead">Wir arbeiten für Einzelunternehmer genauso gern wie für Mittelständler, Vereine oder Behörden. Jedes Projekt bekommt die gleiche Sorgfalt.</p>
      </div>
      <div class="grid grid-3">
        <div class="card"><div class="icon"><Icon name="server" /></div><h3>Unternehmen und Mittelstand</h3><p>Professionelle Firmenwebsites, Karriereseiten und Portale, die Vertrauen schaffen und Anfragen bringen.</p></div>
        <div class="card"><div class="icon"><Icon name="users" /></div><h3>Selbständige, Handwerk und Praxen</h3><p>Moderne Auftritte mit Leistungen, Referenzen, Terminbuchung und Kontakt, schnell umgesetzt.</p></div>
        <div class="card"><div class="icon"><Icon name="euro" /></div><h3>Handel und E-Commerce</h3><p>Onlineshops mit Zahlungsarten, Versand und Warenwirtschaft, rechtssicher und einfach zu bedienen.</p></div>
        <div class="card"><div class="icon"><Icon name="speed" /></div><h3>Start-ups</h3><p>Landingpages, Produktseiten und Web-Apps, die schnell live gehen und mit Ihnen wachsen.</p></div>
        <div class="card"><div class="icon"><Icon name="chat" /></div><h3>Vereine und Verbände</h3><p>Übersichtliche Seiten mit Terminen, Mitgliederbereich und Neuigkeiten, leicht von Ehrenamtlichen zu pflegen.</p></div>
        <div class="card"><div class="icon"><Icon name="doc" /></div><h3>Öffentliche Auftraggeber</h3><p>Barrierefreie Websites nach BITV 2.0 für Behörden, Kommunen und Förderprojekte, auch über Vergabeverfahren. <a href="/oeffentliche-auftraggeber/">Mehr erfahren</a></p></div>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Leistungen</span>
        <h2>Was wir für Sie umsetzen</h2>
      </div>
      <div class="grid grid-3">
        <div class="card"><div class="icon"><Icon name="cms" /></div><h3>Websites</h3><p>Von der kompakten Visitenkarte bis zum umfangreichen Unternehmensauftritt, mit CMS zum Selbstpflegen.</p></div>
        <div class="card"><div class="icon"><Icon name="euro" /></div><h3>Onlineshops</h3><p>Mit WooCommerce, Shopware oder Shopify, inklusive Zahlungsanbieter, Versand und rechtlicher Pflichtangaben.</p></div>
        <div class="card"><div class="icon"><Icon name="speed" /></div><h3>Landingpages</h3><p>Für Kampagnen, Produkteinführungen und Recruiting, optimiert auf Anfragen und Conversions.</p></div>
        <div class="card"><div class="icon"><Icon name="wrench" /></div><h3>Web-Anwendungen</h3><p>Buchungssysteme, Kundenportale, Mitgliederbereiche, Formulare und Schnittstellen zu Ihren Systemen.</p></div>
        <div class="card"><div class="icon"><Icon name="search" /></div><h3>SEO und Relaunch</h3><p>Bessere Platzierungen bei Google, schnellere Ladezeiten und Modernisierung bestehender Websites.</p></div>
        <div class="card"><div class="icon"><Icon name="server" /></div><h3>Hosting und Betreuung</h3><p>Hosting in Deutschland, Updates, Backups, Support und Pflege Ihrer Inhalte zum festen Monatspreis.</p></div>
      </div>
      <div class="btn-row"><a class="btn btn-outline" href="/leistungen/">Alle Leistungen ansehen</a></div>
    </div>
  </section>

  <section class="section section-navy">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">CMS &amp; Technik</span>
        <h2>Wir arbeiten mit dem System, das zu Ihnen passt</h2>
        <p>Wir sind an keine Plattform gebunden. Sie haben schon ein System? Dann arbeiten wir damit. Die Wahl ist noch offen? Dann empfehlen wir das, was zu Ihrem Projekt, Ihrem Team und Ihrem Budget passt.</p>
      </div>
      <ul class="tags" aria-label="Systeme, mit denen wir arbeiten">
        <li>WordPress</li><li>TYPO3</li><li>Drupal</li><li>Contao</li><li>Joomla</li><li>Neos</li><li>Craft CMS</li><li>WooCommerce</li><li>Shopware</li><li>Shopify</li><li>Strapi</li><li>Astro</li>
      </ul>
      <div class="btn-row"><a class="btn btn-primary" href="/cms/">Mehr zu CMS &amp; Technik</a></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Warum Webseiten-Meister</span>
        <h2>Darauf können Sie sich verlassen</h2>
      </div>
      <div class="grid grid-3">
        <div class="card"><div class="icon"><Icon name="users" /></div><h3>Feste Ansprechperson</h3><p>Ein Projektleiter vom ersten Gespräch bis zur Betreuung nach dem Start. Keine Warteschleifen, kurze Wege.</p></div>
        <div class="card"><div class="icon"><Icon name="euro" /></div><h3>Faire Festpreise</h3><p>Sie wissen vorher, was Ihr Projekt kostet. Betreuung und Pflege gibt es zum festen Monatspreis.</p></div>
        <div class="card"><div class="icon"><Icon name="shield" /></div><h3>Sicher und datenschutzkonform</h3><p>Unser Hintergrund liegt in der Informationssicherheit. Updates, Härtung, Backups und DSGVO sind bei uns selbstverständlich.</p></div>
        <div class="card"><div class="icon"><Icon name="access" /></div><h3>Für alle zugänglich</h3><p>Barrierefreie Gestaltung nach WCAG, seit Mitte 2025 durch das Barrierefreiheitsstärkungsgesetz für viele Onlineshops und Dienstleister Pflicht.</p></div>
        <div class="card"><div class="icon"><Icon name="speed" /></div><h3>Schnell und gut auffindbar</h3><p>Schlanke, mobiloptimierte Seiten mit kurzen Ladezeiten und sauberer Suchmaschinenoptimierung.</p></div>
        <div class="card"><div class="icon"><Icon name="lock" /></div><h3>Ihre Website gehört Ihnen</h3><p>Vollständige Übergabe von Zugängen, Inhalten und Quellcode. Keine Abhängigkeit von uns.</p></div>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Projektablauf</span>
        <h2>So läuft ein Projekt mit uns ab</h2>
      </div>
      <ol class="steps">
        <li><h3>Erstgespräch</h3><p>Wir lernen Sie und Ihre Ziele kennen. Danach erhalten Sie ein Konzept und ein Angebot mit Festpreis.</p></li>
        <li><h3>Design und Entwicklung</h3><p>Wir gestalten und entwickeln Ihre Website. Den Fortschritt sehen Sie jederzeit auf einer Testumgebung.</p></li>
        <li><h3>Feinschliff und Start</h3><p>Tests auf allen Geräten, Einweisung in die Pflege und dann geht Ihre Website live.</p></li>
        <li><h3>Betreuung</h3><p>Auf Wunsch kümmern wir uns danach um Hosting, Updates, Backups und neue Inhalte.</p></li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Häufige Fragen</span>
        <h2>Gut zu wissen</h2>
      </div>
      <div class="prose">
        <details><summary>Welche Projekte setzen Sie um?</summary><p>Praktisch alles rund ums Web: Websites, Onlineshops, Landingpages, Portale, Mitgliederbereiche, Buchungssysteme und individuelle Web-Anwendungen. Für kleine Betriebe genauso wie für große Organisationen.</p></details>
        <details><summary>Mit welchem CMS arbeiten Sie?</summary><p>Mit dem, das zu Ihnen passt, zum Beispiel WordPress, TYPO3, Drupal, Contao, Joomla oder Neos, für Shops WooCommerce, Shopware oder Shopify. Haben Sie bereits ein System, arbeiten wir damit weiter.</p></details>
        <details><summary>Können Sie unsere bestehende Website übernehmen?</summary><p>Ja. Wir übernehmen Betreuung und Pflege bestehender Websites oder ziehen Ihre Inhalte auf ein neues System um, ohne dass Ihre Google-Platzierungen verloren gehen.</p></details>
        <details><summary>Was kostet eine Website?</summary><p>Das hängt vom Umfang ab. Eine kompakte Website ist deutlich günstiger als ein Onlineshop oder Portal. Nach dem kostenlosen Erstgespräch erhalten Sie ein Angebot mit Festpreis.</p></details>
        <details><summary>Wie lange dauert ein Projekt?</summary><p>Eine kleine Website ist oft in zwei bis vier Wochen fertig, größere Projekte dauern zwei bis sechs Monate. Den Zeitplan stimmen wir am Anfang gemeinsam ab.</p></details>
      </div>
    </div>
  </section>

  <Cta />
</Base>
