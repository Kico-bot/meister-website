---
import { site } from '../site';
interface Props { title?: string; text?: string }
const {
  title = 'Lassen Sie uns über Ihr Projekt sprechen',
  text = 'Erstgespräch kostenlos und unverbindlich, 30 Minuten. Danach erhalten Sie ein schriftliches Angebot oder eine Kostenschätzung für Ihre Haushaltsplanung.',
} = Astro.props;
---
<section class="section">
  <div class="container">
    <div class="cta">
      <div>
        <h2>{title}</h2>
        <p style="margin:0">{text}</p>
      </div>
      <div class="btn-row" style="margin:0">
        <a class="btn btn-primary" href="/kontakt/">Erstgespräch vereinbaren</a>
        <a class="btn btn-light" href={`mailto:${site.email}`}>E-Mail schreiben</a>
      </div>
    </div>
  </div>
</section>
