---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { site, nav } from '../site';

interface Props { title: string; description: string; noindex?: boolean }
const { title, description, noindex = false } = Astro.props;
const fullTitle = title === site.name ? `${site.name} – ${site.claim}` : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const path = Astro.url.pathname;
const year = new Date().getFullYear();
const ld = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: site.url,
  email: site.email,
  founder: site.owner,
  areaServed: 'DE',
  description,
};
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#101D49" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label={`${site.name} – zur Startseite`}>
          <Logo />
          <span>{site.name}<small>Webdesign · Entwicklung · Betreuung</small></span>
        </a>
        <input type="checkbox" id="nav-toggle" class="nav-toggle visually-hidden" aria-controls="hauptnavigation" />
        <label for="nav-toggle" class="nav-toggle-label">Menü</label>
        <nav class="main-nav" id="hauptnavigation" aria-label="Hauptnavigation">
          <ul>
            {nav.map((item) => (
              <li><a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a></li>
            ))}
            <li><a class="btn btn-primary" href="/kontakt/" aria-current={path === '/kontakt/' ? 'page' : undefined}>Kontakt</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="inhalt">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <a class="brand" href="/" style="color:#fff"><Logo /><span>{site.name}</span></a>
            <p style="margin-top:1rem;max-width:34ch">Websites, Onlineshops und Web-Anwendungen für Unternehmen, Selbständige, Vereine und öffentliche Auftraggeber. Aus München, bundesweit tätig.</p>
          </div>
          <div>
            <h2>Seiten</h2>
            <ul>
              {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
              <li><a href="/kontakt/">Kontakt</a></li>
            </ul>
          </div>
          <div>
            <h2>Rechtliches</h2>
            <ul>
              <li><a href="/impressum/">Impressum</a></li>
              <li><a href="/datenschutz/">Datenschutz</a></li>
              <li><a href="/barrierefreiheit/">Erklärung zur Barrierefreiheit</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {year} {site.name}</span>
          <span>Keine Cookies · kein Tracking · keine externen Schriften</span>
        </div>
      </div>
    </footer>
  </body>
</html>
